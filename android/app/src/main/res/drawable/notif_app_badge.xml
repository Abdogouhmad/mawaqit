<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded sage app badge with the Mawaqit clock glyph, mirrors the Stitch
     notification "app identification" bar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2E7D5B" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:width="16dp"
        android:height="16dp"
        android:drawable="@drawable/ic_stat_mawaqit"
        android:gravity="center" />
</layer-list>
