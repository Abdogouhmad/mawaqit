<?xml version="1.0" encoding="utf-8"?>
<!-- Soft sage circle holding the horizon glyph (Stitch "mini solar micro-glyph"). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#B9EFD0" />
            <stroke
                android:width="1dp"
                android:color="#9DD2B5" />
        </shape>
    </item>
    <item
        android:width="22dp"
        android:height="22dp"
        android:drawable="@drawable/ic_twilight"
        android:gravity="center" />
</layer-list>
