<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_alarm_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingTop="48dp"
        android:paddingBottom="132dp">

        <FrameLayout
            android:layout_width="172dp"
            android:layout_height="172dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_alarm_halo" />

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_alarm_speaker" />
        </FrameLayout>

        <TextView
            android:id="@+id/alarm_eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/alarm_eyebrow"
            android:textColor="@color/alarm_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.35"
            android:gravity="center" />

        <TextView
            android:id="@+id/alarm_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/alarm_default_title"
            android:textColor="@color/alarm_text"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:letterSpacing="0.01" />

        <TextView
            android:id="@+id/alarm_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/alarm_default_clock"
            android:textColor="@color/alarm_text"
            android:textSize="64sp"
            android:fontFamily="sans-serif-thin"
            android:letterSpacing="-0.03"
            android:gravity="center" />

        <TextView
            android:id="@+id/alarm_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/alarm_default_date"
            android:textColor="@color/alarm_subtext"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/alarm_subtitle"
            android:textColor="@color/alarm_subtext"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>

    <Button
        android:id="@+id/alarm_stop"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="28dp"
        android:text="@string/alarm_stop"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/bg_alarm_button"
        android:stateListAnimator="@null"
        android:elevation="0dp" />
</FrameLayout>
