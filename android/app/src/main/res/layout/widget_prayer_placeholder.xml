<?xml version="1.0" encoding="utf-8"?>
<!-- Static RemoteViews shown the instant the widget is added, before the
     first Glance composition lands. Mirrors the Glance card (sage background,
     white name + time + progress) so a freshly placed widget is never a blank
     or "Loading…" spinner on any launcher; Glance content replaces it on the
     first app-driven update. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2E7D5B"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/placeholder_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/placeholder_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="4dp"
            android:text="@string/widget_placeholder_subtitle"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ProgressBar
            android:id="@+id/placeholder_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#40FFFFFF"
            android:progressTint="#BFFFFFFF" />
    </LinearLayout>
</FrameLayout>