<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Mawaqit</string>
    <!-- English fallbacks for the pre-prayer live update. The copy that is
         actually shown is passed from Dart in the reminder payload (ARB, so it
         follows the app language); these are only used when a payload somehow
         carries none. Keep the {prayer}/{time}/{minutes} sentinels literally —
         the native side substitutes them. -->
    <string name="notif_live_channel">Prayer countdown</string>
    <string name="notif_live_channel_description">Live countdown to the next prayer</string>
    <string name="notif_live_body">Prayer time is at {time}</string>
    <string name="notif_live_chip">{prayer} · {minutes}m</string>
    <!-- Every entry uses the same {…} sentinels: the native side substitutes
         them, and a resource with several format arguments would have its
         positional markers stripped by aapt2 when formatted="false". -->
    <string name="notif_live_it_is_time">{prayer} — it\'s time</string>
    <string name="notif_live_action_prayed">Prayed</string>
    <string name="notif_live_action_dismiss">Dismiss</string>
</resources>
